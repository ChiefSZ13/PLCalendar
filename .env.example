# Fully qualified domain whose DNS A/AAAA record points to the Docker server.
PLCALENDAR_DOMAIN=calendar.example.com

# GitHub Container Registry image. Pin production to a released version.
PLCALENDAR_IMAGE=ghcr.io/github-owner/plcalendar:v0.3.0

# Generate each value independently with: openssl rand -hex 32
PLCALENDAR_WRITE_TOKEN=replace-with-a-random-write-token
PLCALENDAR_FEED_TOKEN=replace-with-a-different-random-feed-token
